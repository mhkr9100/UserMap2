# Copy this file to .env and fill in your values.
# See root .env.example for documentation.

PORT=5185
APP_URL=http://localhost:5185

# ── Slack OAuth 2.0 App credentials ──────────────────────────────────────────
# 1. Go to https://api.slack.com/apps → "Create New App" → "From scratch"
# 2. In "OAuth & Permissions" add the following Bot Token Scopes:
#      channels:history   — read messages from public channels
#      channels:read      — list public channels
#      groups:history     — read messages from private channels (optional)
#      groups:read        — list private channels (optional)
#      users:read         — resolve user IDs to display names
#      team:read          — read workspace info (used for account_id)
# 3. Set the Redirect URL to:  http://localhost:5185/api/connect/slack/callback
# 4. Install the app to your workspace and copy the credentials below.
#
# Tokens are persisted in the local SQLite DB (not only env-based).
# The env vars are only used during the initial OAuth exchange.

SLACK_CLIENT_ID=your-slack-client-id
SLACK_CLIENT_SECRET=your-slack-client-secret
SLACK_REDIRECT_URI=http://localhost:5185/api/connect/slack/callback
